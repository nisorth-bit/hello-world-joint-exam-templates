---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

const count = (series: string) => posts.filter(p => p.data.series === series).length;

const categories = [
  {
    title: '男性の更年期',
    slug: 'male',
    desc: 'LOH症候群・テストステロン補充・疲れ・気力低下・EDなど男性ホルモンに関わるコラム。',
    count: count('男性の更年期'),
    color: '#1B5E8A',
    light: '#E8F2FA',
  },
  {
    title: '睡眠・不眠',
    slug: 'sleep',
    desc: '不眠・睡眠時無呼吸・睡眠衛生・CBT-Iなど睡眠の質に関わるコラム。',
    count: count('睡眠・不眠'),
    color: '#2A5C6E',
    light: '#E8F4F0',
  },
  {
    title: '女性の更年期',
    slug: 'female',
    desc: 'ほてり・動悸・HRT・漢方・骨密度など女性ホルモンと更年期に関わるコラム。',
    count: count('女性の更年期'),
    color: '#7A3A6E',
    light: '#F5EAF3',
  },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`コラム | ${SITE_TITLE}`} description="男性更年期・睡眠・女性更年期に関する医療コラム一覧" />
  </head>
  <body>
    <Header />
    <main>
      <div class="page-header">
        <h1>コラム</h1>
        <p>カテゴリーを選んでください。</p>
      </div>

      <div class="category-grid">
        {categories.map(cat => (
          <a href={`/blog/${cat.slug}/`} class="category-card" style={`--cat-color: ${cat.color}; --cat-light: ${cat.light};`}>
            <div class="cat-header">
              <h2>{cat.title}</h2>
              <span class="cat-count">{cat.count}本</span>
            </div>
            <p class="cat-desc">{cat.desc}</p>
            <span class="cat-link">一覧を見る →</span>
          </a>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-header {
    margin-bottom: 2em;
  }
  .page-header h1 {
    margin: 0 0 0.3em;
  }
  .page-header p {
    color: var(--text-secondary);
    margin: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5em;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: 1.8em;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--cat-light);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s, transform 0.15s;
  }

  .category-card:hover {
    box-shadow: var(--box-shadow);
    transform: translateY(-2px);
  }

  .cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.8em;
  }

  .cat-header h2 {
    margin: 0;
    font-size: 1.1em;
    color: var(--cat-color);
  }

  .cat-count {
    font-size: 0.82em;
    font-weight: 700;
    color: var(--cat-color);
    background: #fff;
    padding: 0.2em 0.6em;
    border-radius: 20px;
    border: 1px solid var(--cat-color);
    opacity: 0.8;
  }

  .cat-desc {
    font-size: 0.88em;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 1.2em;
    flex: 1;
  }

  .cat-link {
    font-size: 0.88em;
    font-weight: 600;
    color: var(--cat-color);
  }

  @media (max-width: 720px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
