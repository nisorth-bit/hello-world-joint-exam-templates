---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

const SERIES = '睡眠・不眠';
const posts = (await getCollection('blog'))
  .filter(p => p.data.series === SERIES)
  .sort((a, b) => (a.data.seriesNumber ?? 0) - (b.data.seriesNumber ?? 0));
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={`睡眠・不眠コラム | ${SITE_TITLE}`} description="不眠・睡眠時無呼吸・CBT-I・睡眠衛生に関するコラム一覧" />
  </head>
  <body>
    <Header />
    <main>
      <div class="page-header">
        <a href="/blog/" class="back">← コラムトップ</a>
        <h1>睡眠・不眠</h1>
        <p>不眠・睡眠時無呼吸・睡眠衛生・CBT-Iに関するコラム（{posts.length}本）</p>
      </div>

      <ul class="card-grid">
        {posts.map(post => (
          <li class="card">
            <a href={`/blog/${post.id}/`}>
              <span class="series-badge">#{post.data.seriesNumber}</span>
              <div class="card-tags">
                {(post.data.tags ?? []).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.description}</p>
              <p class="card-date"><FormattedDate date={post.data.pubDate} /></p>
            </a>
          </li>
        ))}
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-header { margin-bottom: 2em; }
  .back { font-size: 0.88em; color: var(--text-secondary); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .page-header h1 { margin: 0.3em 0 0.2em; }
  .page-header p { color: var(--text-secondary); margin: 0; font-size: 0.95em; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2em;
    list-style: none;
    padding: 0; margin: 0;
  }

  .card a {
    display: flex; flex-direction: column; height: 100%;
    padding: 1.2em; border: 1px solid var(--border);
    border-radius: 10px; background: var(--bg);
    text-decoration: none; color: inherit;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .card a:hover { box-shadow: var(--box-shadow); border-color: var(--accent); }

  .series-badge {
    display: inline-block; font-size: 0.78em; font-weight: 700;
    color: #2A5C6E; background: #E8F4F0;
    padding: 0.15em 0.6em; border-radius: 12px; margin-bottom: 0.5em;
  }

  .card-tags { display: flex; flex-wrap: wrap; gap: 0.3em; margin-bottom: 0.6em; }
  .tag {
    font-size: 0.75em; padding: 0.15em 0.5em;
    background: var(--accent-light); color: var(--accent-dark);
    border-radius: 10px; font-weight: 600;
  }

  .card-title { font-size: 0.92em; line-height: 1.5; margin: 0 0 0.5em; font-weight: 700; }
  .card-desc { font-size: 0.82em; color: var(--text-secondary); line-height: 1.6; margin: 0 0 auto; flex: 1; }
  .card-date { font-size: 0.78em; color: var(--text-secondary); margin: 0.7em 0 0; }

  @media (max-width: 720px) { .card-grid { grid-template-columns: 1fr; } }
  @media (min-width: 721px) and (max-width: 960px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
