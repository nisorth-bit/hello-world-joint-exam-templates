---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="footer-name">Vivo Clinic</p>
		<p class="footer-desc">ホルモンと睡眠の専門オンラインクリニック</p>
		<nav class="footer-links">
			<a href="/privacy">プライバシーポリシー</a>
			<span>|</span>
			<a href="/disclaimer">免責事項</a>
			<span>|</span>
			<a href="/about">クリニックについて</a>
		</nav>
		<p class="copyright">&copy; {today.getFullYear()} Vivo Clinic. All rights reserved.</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background-color: var(--bg-subtle);
		padding: 3em 1em 4em;
	}

	.footer-inner {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
	}

	.footer-name {
		font-weight: 700;
		font-size: 1.1em;
		color: var(--text);
		margin: 0 0 0.3em;
	}

	.footer-desc {
		color: var(--text-secondary);
		font-size: 0.9em;
		margin: 0 0 1.2em;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.6em;
		flex-wrap: wrap;
		margin-bottom: 1.2em;
	}

	.footer-links a {
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.88em;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-links span {
		color: var(--border);
	}

	.copyright {
		color: var(--text-secondary);
		font-size: 0.82em;
		margin: 0;
	}
</style>
